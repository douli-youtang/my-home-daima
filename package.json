    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.8",
    "html5-qrcode": "^2.3.8",
    "nuxt": "^3.12.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
