{
  "name": "qrcode-form-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PATH=\"$HOME/.local/node/bin:$PATH\" nuxt dev --host 0.0.0.0 --port 8080",
    "build": "PATH=\"$HOME/.local/node/bin:$PATH\" nuxt build",
    "preview": "PATH=\"$HOME/.local/node/bin:$PATH\" nuxt preview --host 0.0.0.0 --port 8080",
    "postinstall": "prisma generate",
